# Discord Bot Configuration
# Obtain your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Bot command prefix for hybrid/message commands (default: !)
COMMAND_PREFIX=!

# Default card deck to use for scenarios and games
# Options: CoreV2.2, CoreV2.2-Expansion, CoreV2.1, CoreV1, CloudSecurity, RedCanary, DenSecure, Huntress, ICS-OT, Trimarc, all
DEFAULT_DECK=CoreV2.2

# Path to the decks directory
DECKS_DIR=decks

# Maximum number of game turns before incident response fails (default: 10)
MAX_TURNS=10

# Number of consecutive failed rolls before an Inject is automatically drawn (default: 3)
INJECT_FAILURE_THRESHOLD=3

# Optional: Restrict game play to specific channel IDs (comma-separated). Leave blank to allow anywhere.
# ALLOWED_CHANNELS=123456789012345678,987654321098765432
ALLOWED_CHANNELS=

# Optional: Guild ID for instant slash command synchronization in development
# DEV_GUILD_ID=123456789012345678
DEV_GUILD_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
